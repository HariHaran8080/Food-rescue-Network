# Production / Environment Configuration
NODE_ENV=development
PORT=4000

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/food_rescue?schema=public"

# Authentication Secrets
# Generate a secure 32+ byte key in production: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="use-a-strong-random-secret-key-at-least-32-chars-long"
JWT_EXPIRES_IN="7d"

# Allowed Frontend Origins (CORS)
CLIENT_URL="http://localhost:5173"
